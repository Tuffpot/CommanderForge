# Copy this file to .env and fill in your own Supabase project's values.
# Find these under Project Settings -> API in your Supabase dashboard.
# The anon key is meant to be public/exposed in client apps by design —
# it's not a secret, real security comes from Row Level Security policies
# on the database tables (see README.md for the exact setup).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
