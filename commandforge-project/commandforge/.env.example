# Copy this file to .env and fill in your own Supabase project's values.
# Find these under Project Settings -> API in your Supabase dashboard.
# The anon key is meant to be public/exposed in client apps by design —
# it's not a secret, real security comes from Row Level Security policies
# on the database tables (see README.md for the exact setup).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Google AdSense. Leave blank until AdSense gives you a publisher
# ID; with it blank the site shows no ads. Set these in Netlify under
# Site configuration -> Environment variables, then redeploy.
# VITE_ADSENSE_CLIENT is the "ca-pub-..." ID from AdSense -> Account -> Account information.
# VITE_ADSENSE_SLOT is the number from an ad unit you make under Ads -> By ad unit (optional).
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Optional: visitor analytics from Umami (umami.is), which needs no cookie
# banner. Make a free account, add brewhall.co.uk as a website, and paste its
# Website ID here (and in Netlify's environment variables). Leave blank to
# load no analytics. VITE_UMAMI_SCRIPT only needs setting if you run Umami
# yourself.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT=
