// Cloudflare Workers config: serves the built Vite app in dist/ as static
// assets. The name must match the Worker's name in the Cloudflare dashboard.
{
  "name": "commander-forge",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
